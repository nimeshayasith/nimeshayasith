# Copy to .env only if you need to change something. With nothing set, the app calls a same-origin
# /api and /yt: Vite proxies them in dev/preview and an AWS Amplify rewrite does it in production,
# so no CORS settings are needed anywhere.

# Point the dev proxy at another backend (read by vite.config.js, not exposed to the browser):
# BACKEND_ORIGIN=http://localhost:5000

# Bypass the proxy and call the backend directly. The backend must then allow this site's origin in
# its CORS configuration, e.g. https://main.d3ag7vu427q7y9.amplifyapp.com
# VITE_API_URL=https://portfolio-6gcd.onrender.com/api
