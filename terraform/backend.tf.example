# Optional: keep Terraform state in S3 (with locking) instead of on your laptop.
# 1. Create the bucket once:   aws s3api create-bucket --bucket <unique-name> --region us-east-1
#    (enable versioning + default encryption on it)
# 2. Rename this file to backend.tf, fill in the bucket name, run `terraform init -migrate-state`.

terraform {
  backend "s3" {
    bucket       = "REPLACE-ME-terraform-state"
    key          = "portfolio/amplify/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true # S3-native locking (Terraform >= 1.10)
  }
}
